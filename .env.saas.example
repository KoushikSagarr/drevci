# =============================================================
# Drev CI — SaaS Configuration (Supabase)
# Copy this file to .env and fill in your values
# =============================================================

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Found in: Supabase Dashboard → Settings → Database → Connection string
DREV_DB_TYPE=postgres
DREV_DB_URL=postgres://postgres:[YOUR-PASSWORD]@db.okgoarstmlrxcwtfotbp.supabase.co:5432/postgres

# ── Supabase Auth (for dashboard) ────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://okgoarstmlrxcwtfotbp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9rZ29hcnN0bWxyeGN3dGZvdGJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAxMDcyMjYsImV4cCI6MjA5NTY4MzIyNn0.KNk1JoRRQpOEL1vBzl40qBup1sKY3jx7MfAfE8j-a5I

