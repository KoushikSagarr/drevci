# ==============================================================================
# Drev CI — Self-Hosted Configuration (.env.example)
#
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# ==============================================================================

# ── Authentication ────────────────────────────────────────────────────────────
# API bearer token for daemon engine authentication.
# Generate a secure 32-byte hex token with:
#   openssl rand -hex 32
# or using the CLI:
#   drev token generate
DREV_TOKEN=replace_with_a_secure_random_token_e.g._openssl_rand_hex_32

# Operator password for dashboard web UI access.
# Must NOT match DREV_TOKEN.
DASHBOARD_PASSWORD=replace_with_a_strong_operator_password

# Independent high-entropy secret for signing stateless HMAC-SHA256 session cookies.
# Must be at least 32 characters and must NOT match DREV_TOKEN or DASHBOARD_PASSWORD.
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace_with_a_high_entropy_session_secret_min_32_chars


# ── Networking & Ports ────────────────────────────────────────────────────────
# Host bind address for the web dashboard (default: 127.0.0.1 for local isolation).
# WARNING: Change to 0.0.0.0 only when placed behind an authenticating reverse proxy or VPN.
DASHBOARD_BIND_IP=127.0.0.1

# Port for the Next.js web dashboard (exposed on host)
DASHBOARD_PORT=3000

# Port for the Go engine daemon (internal by default; uncomment in docker-compose.yml to expose)
DREV_PORT=9090

# ── Workspace Directory ───────────────────────────────────────────────────────
# Shared host directory for job workspaces.
# Must be an identical absolute path on both host and inside the drevd container
# so the host Docker engine can bind-mount job workspaces into container /workspace.
DREV_WORKSPACE_DIR=/tmp/drev-workspaces

# ── Optional: GitHub Webhook Secret ───────────────────────────────────────────
# HMAC secret for validating incoming GitHub webhook payloads
# DREV_WEBHOOK_SECRET=your_github_webhook_secret

# ── Optional: Container Resource Limits ───────────────────────────────────────
# Default resource constraints applied to job containers to protect the host
# DREV_JOB_CPU_LIMIT=2.0
# DREV_JOB_MEMORY_LIMIT=2GB
# DREV_JOB_SWAP_LIMIT=2GB
# DREV_JOB_PIDS_LIMIT=512

# ── Optional: Notifications ───────────────────────────────────────────────────
# Slack / Discord webhook URLs for pipeline notifications
# DREV_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# DREV_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
